<h1>Blog Posts</h1>

<% @blog_posts.each do |post| %>
  <div class="blog-post">
    <h2><%= link_to post.title, post %></h2>
    <% if post.draft? %>
      <div class="p-2 rounded bg-gray-300 text-gray-900">Draft</div>
    <% elsif post.scheduled? %>
      <div class="p-2 rounded bg-blue-300 text-blue-900">Scheduled</div>
    <% end %>
    <p><%= post.content %></p>
  </div>
<% end %>

<div class="mt-16">
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
